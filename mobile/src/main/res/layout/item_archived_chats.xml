<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="chat"
            type="knnekt.shared.data.entity.Chat" />

    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_chat_list_item"
        android:clickable="true"
        android:focusable="true">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/chat_photo"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_margin="8dp"
            android:scaleType="centerCrop"
            app:srcCompat="@drawable/ic_avatar_archived"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:shapeAppearanceOverlay="@style/CircleImageView"
            tools:srcCompat="@tools:sample/avatars" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginHorizontal="8dp"
            android:orientation="vertical"
            android:paddingVertical="2dp"
            app:layout_constraintBottom_toBottomOf="@id/chat_photo"
            app:layout_constraintEnd_toStartOf="@id/unread_chats_badge"
            app:layout_constraintStart_toEndOf="@id/chat_photo"
            app:layout_constraintTop_toTopOf="@id/chat_photo">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/archived_chats"
                android:textAppearance="@style/ItemTitleTextAppearance"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@+id/chat_photo"
                app:layout_constraintTop_toTopOf="parent"
                tools:text="Chat name" />


            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@{chat.lastMessage}"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@+id/chat_photo"
                app:layout_constraintTop_toTopOf="parent"
                tools:text="Hello, World!" />

        </LinearLayout>


        <TextView
            android:id="@+id/unread_chats_badge"
            invisibleWhen="@{chat.unreadMessageCount.isEmpty()}"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="8dp"
            android:background="@drawable/bg_badge"
            android:backgroundTint="?attr/colorControlNormal"
            android:gravity="center"
            android:paddingVertical="3dp"
            android:paddingHorizontal="8.5dp"
            android:text="@{chat.unreadMessageCount}"
            android:textColor="?android:attr/textColorPrimaryInverse"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            tools:text="99+" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>