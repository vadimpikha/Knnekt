<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="chat"
            type="knnekt.shared.data.entity.Chat" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_chat_list_item"
        android:clickable="true"
        android:focusable="true"
        android:padding="8dp">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/chat_photo"
            imageUri="@{chat.photo}"
            placeholder="@{chat.private ? @drawable/ic_avatar_placeholder : @drawable/ic_avatar_placeholder_group}"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:scaleType="centerCrop"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:shapeAppearanceOverlay="@style/CircleImageView"
            tools:srcCompat="@tools:sample/avatars" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginStart="8dp"
            android:orientation="vertical"
            android:paddingVertical="2dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/additional_indicators"
            app:layout_constraintStart_toEndOf="@id/chat_photo"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/chat_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@{chat.name}"
                android:textAppearance="@style/ItemTitleTextAppearance"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@+id/chat_photo"
                app:layout_constraintTop_toTopOf="parent"
                tools:text="Chat name" />


            <TextView
                android:id="@+id/chat_last_message"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@{chat.lastMessage}"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@+id/chat_photo"
                app:layout_constraintTop_toTopOf="parent"
                tools:text="Hello, World!" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/additional_indicators"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:gravity="center_vertical|end"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/last_message_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@{chat.updatedAt}"
                android:layout_weight="1"
                android:gravity="center"
                tools:text="11:25" />

            <TextView
                android:id="@+id/unread_messages_badge"
                invisibleWhen="@{chat.unreadMessageCount.isEmpty()}"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_badge"
                android:textColor="?android:attr/textColorPrimaryInverse"
                android:backgroundTint="?attr/colorSecondary"
                android:gravity="center"
                android:paddingHorizontal="8.5dp"
                android:text="@{chat.unreadMessageCount}"
                android:textStyle="bold"
                tools:text="99+" />

        </LinearLayout>


    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>