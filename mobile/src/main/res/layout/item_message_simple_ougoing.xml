<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <TextView
        android:id="@+id/message_body"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/shape_bg_outgoing_bubble"
        android:backgroundTint="?attr/colorSecondary"
        android:lineSpacingExtra="2dp"
        android:textColor="?android:attr/textColorPrimaryInverse"
        android:paddingStart="10dp"
        android:paddingTop="6dp"
        android:paddingEnd="32dp"
        android:paddingBottom="24dp"
        android:textAppearance="@style/TextAppearance.MaterialComponents.Body1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_max="wrap"
        app:layout_constraintWidth_percent="0.8"
        tools:text="@tools:sample/lorem[33]" />

    <TextView
        android:id="@+id/message_time"
        style="@style/MessageTimeTextStyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="4dp"
        android:textColor="?android:attr/textColorPrimaryInverse"
        app:layout_constraintBottom_toBottomOf="@id/message_body"
        app:layout_constraintEnd_toEndOf="@id/message_body"
        tools:text="12:13" />

</androidx.constraintlayout.widget.ConstraintLayout>