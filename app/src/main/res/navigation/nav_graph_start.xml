<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph_start.xml"
    app:startDestination="@id/sendCode">

    <fragment
        android:id="@+id/sendCode"
        android:name="blasty.presentation.start.SendConfirmCodeFragment"
        android:label="login_fragment"
        tools:layout="@layout/fragment_send_code" >
        <action
            android:id="@+id/action_loginFragment_to_registrationFragment"
            app:destination="@id/registrationFragment" />
        <action
            android:id="@+id/sendCode_to_signIn"
            app:destination="@id/signIn"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left" />
    </fragment>
    <fragment
        android:id="@+id/registrationFragment"
        android:name="blasty.presentation.start.RegistrationFragment"
        android:label="fragment_registration"
        tools:layout="@layout/fragment_registration" />
    <fragment
        android:id="@+id/signIn"
        android:name="blasty.presentation.start.SignInFragment"
        android:label="SignInFragment" >
        <action
            android:id="@+id/action_signIn_to_registrationFragment"
            app:destination="@id/registrationFragment" />
    </fragment>
</navigation>